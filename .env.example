# PostgreSQL (Neon ou local)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Redis (Upstash ou local) — opcional; fallback automático para memória
REDIS_URL="redis://default:password@host:6379"

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# CSFloat (opcional — proxy ou API key)
CSFLOAT_API_KEY=
CSFLOAT_BASE_URL=https://csfloat.com/api/v1

# ByMykel price tracker
BYMYKEL_PRICES_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/prices.json

# API backend (monorepo @ct/api)
VITE_API_URL=/api/backend
VITE_API_ENABLED=true

CACHE_TTL_PRICES=300
CACHE_TTL_CATALOG=86400
