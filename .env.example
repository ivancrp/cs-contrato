# PostgreSQL (Neon ou local)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Redis (Upstash REST — use URL https://... e token abaixo)
REDIS_URL="https://your-upstash-endpoint.upstash.io"
REDIS_TOKEN=
UPSTASH_REDIS_REST_TOKEN=

# Câmbio estimado (preços em BRL)
USD_TO_BRL=5.5
EUR_TO_BRL=6.0
BUFF_PRICE_MULTIPLIER=0.9

# Next.js (@ct/web)
NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_API_HEALTH_URL=/api/health
API_PROXY_TARGET=http://localhost:3001

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# CSFloat (opcional — proxy ou API key)
CSFLOAT_API_KEY=
CSFLOAT_BASE_URL=https://csfloat.com/api/v1

# ByMykel price tracker
BYMYKEL_PRICES_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/prices.json

# API backend (monorepo @ct/api)
VITE_API_URL=/api/backend
VITE_API_HEALTH_URL=/api/health
VITE_API_ENABLED=true

CACHE_TTL_PRICES=300
CACHE_TTL_CATALOG=86400
CACHE_TTL_OPPORTUNITIES=3600

# Auth opcional para POST /opportunities/scan
API_ADMIN_KEY=
NEXT_PUBLIC_API_ADMIN_KEY=
