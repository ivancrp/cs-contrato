generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rarity {
  consumer
  industrial
  mil_spec     @map("mil-spec")
  restricted
  classified
  covert
  extraordinary
}

enum ProbabilitySource {
  official
  community
  estimated
  unknown
}

enum Marketplace {
  steam
  csfloat
  skinport
  buff
  pricempire
  bymykel
}

model Collection {
  id        String   @id
  name      String   @unique
  imageUrl  String?  @map("image_url")
  skins     Skin[]
  crates    Crate[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("collections")
}

model Skin {
  id            String     @id
  name          String
  weapon        String
  collectionId  String     @map("collection_id")
  collection    Collection @relation(fields: [collectionId], references: [id])
  rarity        Rarity
  minFloat      Decimal    @default(0) @map("min_float") @db.Decimal(6, 5)
  maxFloat      Decimal    @default(1) @map("max_float") @db.Decimal(6, 5)
  stattrak      Boolean    @default(false)
  souvenir      Boolean    @default(false)
  paintIndex    String?    @map("paint_index")
  finishCatalog String?    @map("finish_catalog")
  imageUrl      String?    @map("image_url")
  prices        PriceSnapshot[]
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([name])
  @@index([collectionId])
  @@index([rarity])
  @@map("skins")
}

model Crate {
  id           String      @id
  name         String
  collectionId String?     @map("collection_id")
  collection   Collection? @relation(fields: [collectionId], references: [id])
  year         Int?
  status       String      @default("unknown")
  dropPool     String?     @map("drop_pool")
  drops        CrateDrop[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("crates")
}

model CrateDrop {
  id          String            @id @default(cuid())
  crateId     String            @map("crate_id")
  crate       Crate             @relation(fields: [crateId], references: [id], onDelete: Cascade)
  skinId      String            @map("skin_id")
  dropType    String            @default("skin") @map("drop_type")
  probability Decimal           @db.Decimal(10, 8)
  source      ProbabilitySource @default(unknown)
  confidence  Decimal?          @db.Decimal(4, 3)
  reference   String?
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([crateId])
  @@map("crate_drops")
}

model PriceSnapshot {
  id            String      @id @default(cuid())
  skinId        String      @map("skin_id")
  skin          Skin        @relation(fields: [skinId], references: [id], onDelete: Cascade)
  marketplace   Marketplace
  price         Decimal     @db.Decimal(12, 2)
  currency      String      @default("USD")
  wear          String?
  floatValue    Decimal?    @map("float_value") @db.Decimal(6, 5)
  liquidity     Decimal?    @db.Decimal(6, 3)
  volumeDaily   Decimal?    @map("volume_daily") @db.Decimal(12, 2)
  volumeWeekly  Decimal?    @map("volume_weekly") @db.Decimal(12, 2)
  volumeMonthly Decimal?    @map("volume_monthly") @db.Decimal(12, 2)
  fetchedAt     DateTime    @default(now()) @map("fetched_at")

  @@index([skinId, marketplace])
  @@index([fetchedAt])
  @@map("price_snapshots")
}

model ContractRuleConfig {
  id          String   @id
  name        String
  description String?
  config      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("contract_rules")
}

model SavedContract {
  id        String   @id @default(cuid())
  ruleId    String   @map("rule_id")
  targetId  String   @map("target_id")
  payload   Json
  ev        Decimal? @db.Decimal(12, 2)
  roi       Decimal? @db.Decimal(8, 4)
  riskScore Decimal? @map("risk_score") @db.Decimal(6, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ev])
  @@index([roi])
  @@map("saved_contracts")
}

model SimulationRun {
  id         String   @id @default(cuid())
  contractId String?  @map("contract_id")
  iterations Int
  result     Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("simulation_runs")
}

model OptimizerJob {
  id        String   @id @default(cuid())
  status    String   @default("pending")
  strategy  String
  params    Json
  result    Json?
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("optimizer_jobs")
}
