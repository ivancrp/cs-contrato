{
  "name": "@ct/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate --schema=../../prisma/schema.prisma && tsc -p tsconfig.json",
    "dev": "npm run db:generate && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "echo \"No tests yet\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "db:push": "prisma db push --schema=../../prisma/schema.prisma",
    "postinstall": "prisma generate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@ct/common": "*",
    "@ct/contracts": "*",
    "@ct/engine": "*",
    "@ct/optimizer": "*",
    "@ct/parser": "*",
    "@ct/pricing": "*",
    "@ct/simulator": "*",
    "@ct/types": "*",
    "@ct/workers": "*",
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.3.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "prisma": "^6.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.6.2",
    "vitest": "^2.1.8"
  }
}
